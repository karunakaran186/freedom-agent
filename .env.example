# ===================================================
# MY INDIA. MY FREEDOM. 🇮🇳 - Environment Configuration
# ===================================================

# OpenRouter API Key (Primary AI Provider)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model ID (Default: anthropic/claude-3.5-sonnet)
# Examples:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   meta-llama/llama-3.3-70b-instruct
#   google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Application Public URL (used for OpenRouter HTTP-Referer header)
APP_URL=https://myindiamyfreedom.app

# ===================================================
# Optional: Lightweight Persistent Counter (Upstash / Vercel KV)
# If unconfigured, the app falls back to in-memory counter baseline.
# ===================================================
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
